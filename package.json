{
  "name": "fontdue-sanity-sync",
  "version": "0.3.1",
  "description": "Sanity schemas and sync engine for Fontdue font data",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "Bartek Pierscinski <bartoszjpierscinski@gmail.com>",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js",
      "default": "./dist/schemas/index.js"
    },
    "./sync": {
      "types": "./dist/sync/index.d.ts",
      "import": "./dist/sync/index.js",
      "default": "./dist/sync/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@sanity/client": "^6.0.0 || ^7.0.0",
    "sanity": "^3.0.0"
  },
  "devDependencies": {
    "@sanity/client": "^7.0.0",
    "@types/node": "^22.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanity": "^3.0.0",
    "typescript": "^5.6.0"
  }
}
